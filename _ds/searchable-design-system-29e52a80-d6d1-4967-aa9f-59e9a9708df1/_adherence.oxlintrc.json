{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:PP Neue Montreal|Instrument Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: PP Neue Montreal, Instrument Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncementBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|linkLabel|href|style|key|ref|className|style|children)$/]",
        "message": "<AnnouncementBar> doesn't accept that prop. Declared props: children, linkLabel, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|dot|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|live|outline|onDark)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'live' | 'outline' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|arrow|icon|disabled|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, arrow, icon, disabled, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|accentSoft|dark|outline|onDark|onAccent)$/]",
        "message": "<Button> variant must be one of 'accent' | 'accentSoft' | 'dark' | 'outline' | 'onDark' | 'onAccent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|dashed|tone|dots|hover|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding, dashed, tone, dots, hover, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|subtle|dark)$/]",
        "message": "<Card> tone must be one of 'plain' | 'subtle' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|style|key|ref|className|style|children)$/]",
        "message": "<ComparisonTable> doesn't accept that prop. Declared props: columns, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|actions|tone|style|key|ref|className|style|children)$/]",
        "message": "<CtaBand> doesn't accept that prop. Declared props: title, children, actions, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|dark)$/]",
        "message": "<CtaBand> tone must be one of 'accent' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailCaptureBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|cta|leftNote|rightNote|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<EmailCaptureBar> doesn't accept that prop. Declared props: placeholder, cta, leftNote, rightNote, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|children|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: question, children, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|style|key|ref|className|style|children)$/]",
        "message": "<FeatureCell> doesn't accept that prop. Declared props: icon, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tone|filled|style|key|ref|className|style|children)$/]",
        "message": "<IconCircle> doesn't accept that prop. Declared props: children, size, tone, filled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:hairline|accent|dark|onDark)$/]",
        "message": "<IconCircle> tone must be one of 'hairline' | 'accent' | 'dark' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoWall'] > JSXAttribute > JSXIdentifier[name!=/^(?:logos|style|key|ref|className|style|children)$/]",
        "message": "<LogoWall> doesn't accept that prop. Declared props: logos, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MegaMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|links|featured|footerLabel|onFooter|style|key|ref|className|style|children)$/]",
        "message": "<MegaMenu> doesn't accept that prop. Declared props: label, links, featured, footerLabel, onFooter, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedFeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|total|title|description|items|style|key|ref|className|style|children)$/]",
        "message": "<NumberedFeatureCard> doesn't accept that prop. Declared props: step, total, title, description, items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromptChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|meta|flag|muted|style|key|ref|className|style|children)$/]",
        "message": "<PromptChip> doesn't accept that prop. Declared props: children, meta, flag, muted, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReportCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|live|linkLabel|href|style|key|ref|className|style|children)$/]",
        "message": "<ReportCard> doesn't accept that prop. Declared props: icon, title, children, live, linkLabel, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|right|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionMarker> doesn't accept that prop. Declared props: index, label, right, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionMarker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SectionMarker> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|address|legal|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: columns, address, legal, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|onLogin|onStart|style|key|ref|className|style|children)$/]",
        "message": "<SiteNav> doesn't accept that prop. Declared props: items, active, onSelect, onLogin, onStart, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceRankList'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|rows|style|key|ref|className|style|children)$/]",
        "message": "<SourceRankList> doesn't accept that prop. Declared props: title, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|active|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: tabs, active, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Testimonial'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|quote|name|role|portrait|features|style|key|ref|className|style|children)$/]",
        "message": "<Testimonial> doesn't accept that prop. Declared props: logo, quote, name, role, portrait, features, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|prefix|size|invalid|disabled|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: placeholder, value, onChange, prefix, size, invalid, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<TextInput> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TwoToneHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|rest|accent|size|align|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<TwoToneHeading> doesn't accept that prop. Declared props: lead, rest, accent, size, align, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TwoToneHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<TwoToneHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|light)$/]",
        "message": "<Wordmark> tone must be one of 'ink' | 'light'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
