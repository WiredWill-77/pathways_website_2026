# Copy to .env.local for local work. On cPanel, set these in the Node.js app's
# environment variables BEFORE running the build (NEXT_PUBLIC_ values are baked in at build time).

# Supabase project URL and publishable (anon) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public site URL, used for metadata.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Server only. Address that receives form notifications.
NOTIFY_EMAIL=info@example.com

# Never put a service_role or secret key in a NEXT_PUBLIC_ variable. The site does not need one.
